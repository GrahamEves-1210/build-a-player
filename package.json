{
  "name": "build-a-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/compress-images.mjs && vite build && node scripts/strip-dist-headshots.mjs && node scripts/prerender-bucket.mjs",
    "build:app": "node scripts/compress-images.mjs && vite build --mode app && node scripts/strip-dist-headshots.mjs && cap sync",
    "assets:app": "capacitor-assets generate --ios --android --iconBackgroundColor \"#090a0d\" --iconBackgroundColorDark \"#090a0d\" --splashBackgroundColor \"#090a0d\" --splashBackgroundColorDark \"#090a0d\"",
    "preview": "vite preview",
    "headshots": "node scripts/fetch-headshots.js"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.3",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jimp": "^1.6.1",
    "sharp": "^0.35.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
